# Frontend (public values, safe to expose to the browser)
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# NOTE: server secrets do NOT go in this file. Set them on the Convex deployment:
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN https://your-app.clerk.accounts.dev
#   npx convex env set GEMINI_API_KEY your-gemini-key        (optional: enables the AI assistant)

# Optional server env (set with `npx convex env set`, never in the browser):
#   AT_USERNAME / AT_API_KEY / AT_SANDBOX / AT_SENDER_ID   Africa's Talking SMS
#   CLERK_WEBHOOK_SECRET                                   removes members deleted in Clerk
